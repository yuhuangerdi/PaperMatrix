{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papermatrix.local/schemas/problem-syntheses.schema.json",
  "title": "PaperMatrix Problem Syntheses",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "revision",
    "updated_at",
    "boards",
    "field_problems",
    "paper_contributions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "format": "uuid"},
    "revision": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "boards": {
      "type": "array",
      "items": {"$ref": "#/$defs/problemBoard"}
    },
    "field_problems": {
      "type": "array",
      "items": {"$ref": "#/$defs/fieldProblem"}
    },
    "paper_contributions": {
      "type": "array",
      "items": {"$ref": "#/$defs/paperContribution"}
    }
  },
  "$defs": {
    "itemReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_id", "item_id"],
      "properties": {
        "paper_id": {"type": "string", "format": "uuid"},
        "item_id": {"type": "string", "format": "uuid"}
      }
    },
    "problemBoard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "board_id",
        "name",
        "purpose",
        "scope_id",
        "problem_ids",
        "paper_ids",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "board_id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "purpose": {"type": "string", "maxLength": 5000},
        "scope_id": {"type": "string", "format": "uuid"},
        "problem_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "format": "uuid"}
        },
        "paper_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "format": "uuid"}
        },
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "fieldProblem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_id",
        "name",
        "definition",
        "scope_note",
        "aliases",
        "tags",
        "status",
        "source_problem_refs",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "problem_id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1, "maxLength": 300},
        "definition": {"type": "string", "minLength": 1, "maxLength": 20000},
        "scope_note": {"type": "string", "maxLength": 10000},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "status": {"type": "string", "enum": ["active", "archived"]},
        "source_problem_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/itemReference"}
        },
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "paperContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contribution_id",
        "problem_id",
        "paper_id",
        "research_problem_item_id",
        "method_item_id",
        "experiment_item_id",
        "resolution_level",
        "rationale",
        "supporting_evidence_ids",
        "counter_evidence",
        "conditions",
        "user_judgment",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "contribution_id": {"type": "string", "format": "uuid"},
        "problem_id": {"type": "string", "format": "uuid"},
        "paper_id": {"type": "string", "format": "uuid"},
        "research_problem_item_id": {"type": "string", "format": "uuid"},
        "method_item_id": {"type": ["string", "null"], "format": "uuid"},
        "experiment_item_id": {"type": ["string", "null"], "format": "uuid"},
        "resolution_level": {
          "type": "string",
          "enum": [
            "resolved",
            "partially_resolved",
            "indirectly_mitigated",
            "not_resolved",
            "not_addressed",
            "not_applicable",
            "unknown"
          ]
        },
        "rationale": {"type": "string", "maxLength": 20000},
        "supporting_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "format": "uuid"}
        },
        "counter_evidence": {"type": "string", "maxLength": 20000},
        "conditions": {"type": "string", "maxLength": 20000},
        "user_judgment": {"type": "string", "maxLength": 20000},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
