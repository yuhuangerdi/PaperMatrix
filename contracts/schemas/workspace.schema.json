{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papermatrix.local/schemas/workspace.schema.json",
  "title": "PaperMatrix Workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "name", "created_at", "updated_at", "revision", "allowed_paper_roots", "settings"],
  "properties": {
    "schema_version": {"const": 1},
    "workspace_id": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "revision": {"type": "integer", "minimum": 1},
    "allowed_paper_roots": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "default_export_format", "strict_hashing"],
      "properties": {
        "language": {"type": "string", "enum": ["zh-CN", "en-US"]},
        "default_export_format": {"type": "string", "enum": ["xlsx", "csv"]},
        "strict_hashing": {"type": "boolean"}
      }
    }
  }
}
