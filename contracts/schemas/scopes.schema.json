{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papermatrix.local/schemas/scopes.schema.json",
  "title": "PaperMatrix Analysis Scopes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "revision", "updated_at", "scopes"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "format": "uuid"},
    "revision": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope_id", "name", "purpose", "paper_ids", "source_filter_snapshot", "created_at", "updated_at"],
        "properties": {
          "scope_id": {"type": "string", "format": "uuid"},
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "purpose": {"type": "string", "maxLength": 5000},
          "paper_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "format": "uuid"}
          },
          "source_filter_snapshot": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          },
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
